# NAS 出片控制台 — 环境变量示例
# 复制为 .env 并按实际部署填写。本文件不含任何真实地址或密钥。

# 控制台工作目录（存放 state.json / config.json / packages/ 等）
CONSOLE_BASE=/opt/n8n/console

# n8n 工作流产物根目录
WF_ROOT=/opt/n8n/workflows

# 监听
CONSOLE_PORT=20130
# 默认仅本机可访问。设为 0.0.0.0 时必须同时设置 CONSOLE_TOKEN，否则拒绝启动
CONSOLE_BIND=127.0.0.1
# 访问令牌（建议用 openssl rand -hex 32 生成）
CONSOLE_TOKEN=

# n8n 主工作流 ID
WF_ID=nasFullPipelineManual

# 下游服务地址（占位值，部署时覆盖）
N8N_URL=http://localhost:5678
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=18764
MODEL_GATEWAY_URL=http://localhost:20128

# 工作流节点备份目录（可选）
BACKUP_DIR=/opt/n8n/_patch
